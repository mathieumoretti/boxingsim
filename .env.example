# Boxing Simulation Environment Variables
# ========================================
# Copy this file to .env.local and modify as needed
# NEVER commit .env or .env.local - they contain secrets!
#
# Required variables are marked with [REQUIRED]
# Variables without defaults MUST be set

# =============================================================================
# ENVIRONMENT SELECTION
# =============================================================================
# Environment: development, test, production (default: development)
# Determines which YAML config file to load (e.g., config/development.yaml)
BOXING_ENV=development

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
BOXING_SERVER_PORT=8080
BOXING_SERVER_HOST=localhost

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
# Docker-mapped port is 5433 (container's internal 5432)
# For non-Docker setups, use 5432
BOXING_DATABASE_HOST=localhost
BOXING_DATABASE_PORT=5433
BOXING_DATABASE_USER=postgres
BOXING_DATABASE_NAME=boxing_dev

# [REQUIRED] Database password - MUST be set for security!
# Default "boxing123" is ONLY for local development convenience
BOXING_DATABASE_PASSWORD=your-secure-database-password-here

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
# Uncomment BOXING_REDIS_PASSWORD if Redis requires authentication
BOXING_REDIS_ADDR=localhost:6379
# BOXING_REDIS_PASSWORD=

# =============================================================================
# JWT CONFIGURATION [REQUIRED]
# =============================================================================
# JWT secret is REQUIRED for authentication
# Change this to a secure random string in production!
# Generate one with: openssl rand -base64 32
BOXING_JWT_SECRET=change-this-to-a-secure-random-string-in-production

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Options: debug, info, warn, error
BOXING_LOGGING_LEVEL=debug

# =============================================================================
# TEST DATABASE CONFIGURATION (Integration Tests Only)
# =============================================================================
# These are REQUIRED for integration tests to prevent accidental production DB access
# No defaults - tests will fail with clear error if missing
# See CONFIGURATION.md for details
#
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5433
# TEST_DB_USER=testuser
# TEST_DB_PASSWORD=testpassword
