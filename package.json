{
  "name": "boxing-simulator-frontend",
  "version": "1.0.0",
  "description": "Modern React frontend for Boxing Simulator",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "clean": "rm -rf dist",
    "test": "jest --watch",
    "test:ci": "jest --coverage --ci",
    "test:integration": "jest src/__tests__/integration --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathIgnorePatterns=/__tests__/integration/"
  },
  "keywords": ["react", "webpack", "boxing", "simulator"],
  "author": "Boxing Simulator Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.24.7",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.3.4",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}